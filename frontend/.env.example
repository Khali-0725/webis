# Base URL of the Laravel API. No trailing slash.
# Laragon typically serves the backend at http://webis.test or http://localhost:8000.
VITE_API_URL=http://localhost:8000

# Shown in the browser tab and the sidebar wordmark.
VITE_APP_NAME=WEBIS

# Pusher Channels (realtime pushes for messages / bookings / payments).
# Leave the key empty to run on polling only - everything still works.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=ap1
