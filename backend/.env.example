APP_NAME=WEBIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file

# ---------------------------------------------------------------------------
# Frontend (React SPA)
# ---------------------------------------------------------------------------
# Where the SPA is served from. Used for password-reset and email-verification
# links. SANCTUM_STATEFUL_DOMAINS decides which origins get a session cookie;
# CORS_ALLOWED_ORIGINS decides which origins the browser may send them from.
# All three must agree, including the port.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Google Sign-In ("Continue with Google" on Register/Login)
# ---------------------------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Not a secret - it must equal the frontend's
# VITE_GOOGLE_CLIENT_ID exactly, since it is checked against the `aud` claim
# of every Google ID token. Leave empty to keep the button hidden and Google
# sign-in disabled - email/password auth is unaffected either way.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Database (Laragon default MySQL credentials)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webis
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session (cookie auth for the SPA)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leading dot shares the cookie between api.example.com and example.com in
# production. Leave null for localhost development.
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Set true in production (HTTPS only).
SESSION_SECURE_COOKIE=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Realtime pushes (new message / booking / payment) go through Pusher
# Channels in production. `log` locally just writes them to laravel.log; the
# SPA still polls underneath so nothing breaks without Pusher.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Uploads go to the private `local` disk, never to `public`.
WEBIS_UPLOAD_DISK=local

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# `log` writes verification and reset mails into storage/logs/laravel.log,
# which needs no service running.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@webis.local"
MAIL_FROM_NAME="${APP_NAME}"

# Laragon bundles Mailpit, which gives you a real inbox UI at
# http://localhost:8025. To use it, start Mailpit in Laragon and swap the three
# lines above for:
#   MAIL_MAILER=smtp
#   MAIL_HOST=127.0.0.1
#   MAIL_PORT=1025
# We switch to this in Phase 3, when email verification goes in.
